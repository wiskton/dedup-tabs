{
  "manifest_version": 3,
  "name": "Dedup Tabs & Favoritos",
  "version": "1.0.0",
  "description": "Fecha abas repetidas com prévia e encontra favoritos duplicados, mostrando a pasta de cada um para excluir em um painel.",
  "permissions": [
    "tabs",
    "bookmarks",
    "storage"
  ],
  "action": {
    "default_title": "Dedup Tabs",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "src/panel.html",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
